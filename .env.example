CROSSREF_MAILTO=your-email@example.com
OPENALEX_MAILTO=your-email@example.com
CACHE_TTL_MS=1800000
REQUEST_TIMEOUT_MS=15000
REQUEST_MAX_RETRIES=2
REQUEST_BACKOFF_BASE_MS=500
REQUEST_USER_AGENT=physics-paper-hub/1.0 (+https://example.com)
SOURCE_REFRESH_CONCURRENCY=3
METADATA_ENRICH_CONCURRENCY=3
REFRESH_TOKEN=change-this-token
CRON_SECRET=change-this-cron-secret
CLASSIFICATION_ADMIN_TOKEN=change-this-admin-token

# Neon/Vercel Postgres connection string. POSTGRES_URL is also supported.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional model review for papers that rule classification cannot resolve.
OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=gpt-5-mini
